function syncCollectItems(DOMDocument $dom): array
{
    $xpath = new DOMXPath($dom);
    $items = [];

    $nodes = $xpath->query(
        '//*[local-name()="StockPosition"]'
    );

    if ($nodes instanceof DOMNodeList && $nodes->length > 0) {
        foreach ($nodes as $node) {
            if (!$node instanceof DOMElement) {
                continue;
            }

            $product = syncFirst(
                $xpath,
                $node,
                ['Product']
            );

            $producer = $product
                ? syncFirst(
                    $xpath,
                    $product,
                    ['Producer']
                )
                : null;

            $item = [
                'quantity' => syncNumber(
                    syncValue(
                        $xpath,
                        $node,
                        ['Quantity', 'amount']
                    )
                ),
                'inform_f1_reg_id' => syncValue(
                    $xpath,
                    $node,
                    ['InformF1RegId']
                ),
                'inform_f2_reg_id' => syncValue(
                    $xpath,
                    $node,
                    ['InformF2RegId', 'Form2']
                ),
                'alc_percent' => syncNumber(
                    syncValue(
                        $xpath,
                        $node,
                        ['alcPercent']
                    )
                ),
                'alc_percent_min' => syncNumber(
                    syncValue(
                        $xpath,
                        $node,
                        ['alcPercentMin']
                    )
                ),
                'alc_percent_max' => syncNumber(
                    syncValue(
                        $xpath,
                        $node,
                        ['alcPercentMax']
                    )
                ),
                'full_name' => $product
                    ? syncValue(
                        $xpath,
                        $product,
                        ['FullName']
                    )
                    : syncValue($xpath, $node, ['FullName']),
                'alc_code' => $product
                    ? syncValue(
                        $xpath,
                        $product,
                        ['AlcCode']
                    )
                    : syncValue($xpath, $node, ['AlcCode']),
                'capacity' => $product
                    ? syncNumber(
                        syncValue(
                            $xpath,
                            $product,
                            ['Capacity']
                        )
                    )
                    : null,
                'unit_type' => $product
                    ? syncValue(
                        $xpath,
                        $product,
                        ['UnitType']
                    )
                    : null,
                'alc_volume' => $product
                    ? syncNumber(
                        syncValue(
                            $xpath,
                            $product,
                            ['AlcVolume']
                        )
                    )
                    : null,
                'product_v_code' => $product
                    ? syncValue(
                        $xpath,
                        $product,
                        ['ProductVCode']
                    )
                    : null,
                'producer_client_reg_id' => $producer
                    ? syncValue(
                        $xpath,
                        $producer,
                        ['ClientRegId']
                    )
                    : null,
                'producer_inn' => $producer
                    ? syncValue(
                        $xpath,
                        $producer,
                        ['INN']
                    )
                    : null,
                'producer_kpp' => $producer
                    ? syncValue(
                        $xpath,
                        $producer,
                        ['KPP']
                    )
                    : null,
                'producer_full_name' => $producer
                    ? syncValue(
                        $xpath,
                        $producer,
                        ['FullName']
                    )
                    : null,
                'producer_short_name' => $producer
                    ? syncValue(
                        $xpath,
                        $producer,
                        ['ShortName']
                    )
                    : null,
                'producer_country' => $producer
                    ? syncValue(
                        $xpath,
                        $producer,
                        ['Country']
                    )
                    : null,
                'producer_region_code' => $producer
                    ? syncValue(
                        $xpath,
                        $producer,
                        ['RegionCode']
                    )
                    : null,
                'producer_address' => $producer
                    ? syncValue(
                        $xpath,
                        $producer,
                        ['description']
                    )
                    : null,
                'raw_xml' => $dom->saveXML($node)
            ];

            $items[] = $item;
        }

        return $items;
    }

    $positionNodes = $xpath->query(
        '//*[local-name()="Position"]'
    );

    if ($positionNodes instanceof DOMNodeList) {
        foreach ($positionNodes as $position) {
            if (!$position instanceof DOMElement) {
                continue;
            }

            $step = syncFirst(
                $xpath,
                $position,
                ['step']
            );

            if (!$step) {
                continue;
            }

            $items[] = [
                'quantity' => syncNumber(
                    syncValue(
                        $xpath,
                        $step,
                        ['amount']
                    )
                ),
                'inform_f1_reg_id' => null,
                'inform_f2_reg_id' => syncValue(
                    $xpath,
                    $step,
                    ['Form2']
                ),
                'alc_percent' => null,
                'alc_percent_min' => null,
                'alc_percent_max' => null,
                'full_name' => null,
                'alc_code' => null,
                'capacity' => null,
                'unit_type' => null,
                'alc_volume' => null,
                'product_v_code' => null,
                'producer_client_reg_id' => syncValue(
                    $xpath,
                    $step,
                    ['Shipper']
                ),
                'producer_inn' => null,
