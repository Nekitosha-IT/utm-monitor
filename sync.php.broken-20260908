                'producer_country' => null,
                'producer_region_code' => null,
                'producer_address' => null,
                'raw_xml' => $dom->saveXML($position)
            ];
        }
    }

    return $items;
}

function syncParseDocument(
    string $xml,
    string $queueType,
    int $queueId,
    ?string $replyId
): array {
    libxml_use_internal_errors(true);

    $dom = new DOMDocument();

    if (!$dom->loadXML($xml)) {
        $errors = [];

        foreach (libxml_get_errors() as $error) {
            $errors[] = trim($error->message);
        }

        libxml_clear_errors();

        throw new RuntimeException(
            'Invalid XML: ' . implode('; ', $errors)
        );
    }

    libxml_clear_errors();

    $xpath = new DOMXPath($dom);

    $docNode = $xpath->query(
        '/*[local-name()="Documents"]/*[local-name()="Document"]/*[1]'
    );

    if (
        !$docNode instanceof DOMNodeList ||
        $docNode->length === 0
    ) {
        throw new RuntimeException(
            'Document node not found'
        );
    }

    $businessNode = $docNode->item(0);

    if (!$businessNode instanceof DOMElement) {
        throw new RuntimeException(
            'Invalid business document node'
        );
    }

    $documentType = $queueType;

    $typeFromXml = strtolower(
        $businessNode->localName
    );

    if ($typeFromXml !== '') {
        $documentType = $businessNode->localName;
    }

    $sender = syncValue(
        $xpath,
        $businessNode,
        ['Shipper', 'Sender']
    );

    $receiver = syncValue(
        $xpath,
        $businessNode,
        ['Consignee', 'Receiver']
    );

    $number = syncValue(
        $xpath,
        $businessNode,
        ['NUMBER', 'WBNUMBER', 'RegID']
    );

    $documentDate = syncValue(
        $xpath,
        $businessNode,
        ['Date', 'WBDate', 'TicketDate', 'RestsDate', 'EGAISFixDate']
    );

    $status = null;

    $conclusion = syncValue(
        $xpath,
        $businessNode,
        ['Conclusion']
    );

    if ($conclusion !== null) {
        $status = $conclusion;
    } elseif ($documentType === 'Ticket') {
        $status = 'Received';
    } else {
        $status = 'Received';
    }

    $businessIdentity = syncValue(
        $xpath,
        $businessNode,
        ['Identity', 'DocId', 'WBRegId', 'TransportId']
    );

    $externalId = implode(':', [
        'queue',
        $queueType,
        (string)$queueId
    ]);

    if ($replyId !== null && $replyId !== '') {
        $externalId .= ':' . $replyId;
    }

    $items = syncCollectItems($dom);

    return [
        'external_id' => $externalId,
        'queue_type' => $queueType,
        'queue_id' => $queueId,
        'reply_id' => $replyId,
        'document_type' => $documentType,
        'direction' => 'outgoing',
        'number' => $number,
        'document_date' => $documentDate,
        'sender' => $sender,
        'receiver' => $receiver,
        'status' => $status,
        'identity' => $businessIdentity,
        'items' => $items,
        'dom' => $dom
    ];
}

function syncParseQueue(string $xml): array
{
    libxml_use_internal_errors(true);

    $dom = new DOMDocument();

    if (!$dom->loadXML($xml)) {
        throw new RuntimeException(
            'Cannot parse /opt/out XML'
        );
    }

    libxml_clear_errors();

    $xpath = new DOMXPath($dom);
    $result = [];

    $nodes = $xpath->query(
        '//*[local-name()="url"]'
    );

    if (!$nodes instanceof DOMNodeList) {
        return [];
    }

    foreach ($nodes as $node) {
        if (!$node instanceof DOMElement) {
            continue;
        }

        $url = trim($node->textContent);

        if ($url === '') {
            continue;
        }

        $replyId = trim(
            (string)$node->getAttribute('replyId')
        );

        if ($replyId === '') {
            $replyId = null;
        }

        $path = parse_url(
            $url,
            PHP_URL_PATH
        );

        if (!is_string($path)) {
            continue;
        }

        if (
            !preg_match(
                '#/opt/out/([^/]+)/(\d+)$#',
                $path,
                $m
            )
        ) {
            continue;
        }

        $result[] = [
            'type' => $m[1],
            'id' => (int)$m[2],
            'reply_id' => $replyId,
            'url' => $url
        ];
    }

    return $result;
}

function runSync(PDO $db, int $utmId): array
{
    $utm = syncGetUtm(
        $db,
        $utmId
    );

    if (!$utm) {
        throw new RuntimeException(
            'UTM not found: ' . $utmId
        );
    }

    $ip = (string)$utm['ip'];
    $port = (int)$utm['port'];

    $base = 'http://' . $ip . ':' . $port;

    $queue = syncHttpGet(
        $base . '/opt/out',
        20
    );

    if (!$queue['ok']) {
        throw new RuntimeException(
            'Cannot read /opt/out: ' .
            ($queue['error'] ?? 'unknown error')
        );
    }

    $entries = syncParseQueue(
        (string)$queue['data']
    );

    $stats = [
        'utm_id' => $utmId,
        'utm_name' => $utm['name'] ?? null,
        'queue_total' => count($entries),
        'processed' => 0,
        'created_or_updated' => 0,
        'items' => 0,
        'errors' => [],
        'documents' => []
    ];

    foreach ($entries as $entry) {
        try {
            $response = syncHttpGet(
                (string)$entry['url'],
                20
            );

            if (!$response['ok']) {
                throw new RuntimeException(
                    'HTTP ' . $response['status']
                );
            }

            $parsed = syncParseDocument(
                (string)$response['data'],
                (string)$entry['type'],
                (int)$entry['id'],
                $entry['reply_id']
            );

            $db->beginTransaction();

            $documentId = syncDocumentUpsert(
                $db,
                $utmId,
                $parsed,
                (string)$response['data']
            );

            syncDeleteItems($db, (int)$documentDbId);

            foreach ($parsed['items'] as $index => $item) {
                syncSaveItem($db, (int)$documentDbId,
                    $index + 1,
                    $item
                );
            }

            if (
                in_array(
                    'events',
                    syncTables($db),
                    true
                )
            ) {
                $eventColumns = [];

                $stmt = $db->query(
                    'PRAGMA table_info(events)'
                );

                while ($row = $stmt->fetch(PDO::FETCH_ASSOC)) {
                    $eventColumns[] = $row['name'];
                }

                $eventData = [];

                syncSetDocumentField(
                    $eventData,
                    $eventColumns,
                    'utm_id',
                    $utmId
                );

                syncSetDocumentField(
                    $eventData,
                    $eventColumns,
                    'event_type',
                    'document_sync'
                );

                syncSetDocumentField(
                    $eventData,
                    $eventColumns,
                    'message',
                    $entry['type'] .
                    '/' .
                    $entry['id']
                );

                syncSetDocumentField(
                    $eventData,
                    $eventColumns,
                    'created_at',
                    date('Y-m-d H:i:s')
                );

                syncInsertDynamic(
                    $db,
                    'events',
                    $eventData
                );
            }

            $db->commit();

            $stats['processed']++;
            $stats['created_or_updated']++;
            $stats['items'] += count(
                $parsed['items']
            );

            $stats['documents'][] = [
                'id' => $documentId,
                'type' => $parsed['document_type'],
                'queue_type' => $entry['type'],
                'queue_id' => $entry['id'],
                'number' => $parsed['number'],
                'date' => $parsed['document_date'],
                'status' => $parsed['status'],
                'items' => count($parsed['items'])
            ];
        } catch (Throwable $e) {
            if ($db->inTransaction()) {
                $db->rollBack();
            }

            $stats['errors'][] = [
                'type' => $entry['type'],
                'id' => $entry['id'],
                'error' => $e->getMessage()
            ];
        }
    }

    return $stats;
}

function outputSync(array $result): void
{
    echo json_encode(
        [
            'success' => count($result['errors']) === 0,
            'data' => $result
        ],
        JSON_UNESCAPED_UNICODE |
        JSON_UNESCAPED_SLASHES |
        JSON_PRETTY_PRINT
    );
}

$utmId = 1;

if (PHP_SAPI === 'cli') {
    global $argc, $argv;

    foreach ($argv as $arg) {
        if (preg_match('/^--utm=(\d+)$/', $arg, $m)) {
            $utmId = (int)$m[1];
        }
    }

    try {
        $result = runSync($db, $utmId);
        outputSync($result);
    } catch (Throwable $e) {
        echo json_encode(
            [
                'success' => false,
                'error' => $e->getMessage()
            ],
            JSON_UNESCAPED_UNICODE |
            JSON_UNESCAPED_SLASHES |
            JSON_PRETTY_PRINT
        );
        exit(1);
    }
}