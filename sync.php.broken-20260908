declare(strict_types=1);

/**
 * UTM Monitor document synchronizer.
 *
 * Reads:
 *   /opt/out
 *   /api/db/in/list
 *   /api/db/out/list
 *
 * Stores:
 *   documents
 *   document_items
 *   events
 *
 * Works with:
 *   Ticket
 *   ReplyRests_v3
 *   ReplyRestsShop_v2
 *   WayBill_v4
 *   TTNHISTORYF2REG
 *   FORM2REGINFO
 */

$config = require __DIR__ . '/config.php';
$db = require __DIR__ . '/includes/database.php';

if (!isset($db) || !$db instanceof PDO) {
    throw new RuntimeException('Database connection is not available.');
}

function syncText(?DOMElement $node): ?string
{
    if (!$node) {
        return null;
    }

    $value = trim($node->textContent);

    return $value === '' ? null : $value;
}

function syncFirst(DOMXPath $xpath, DOMNode $context, array $names): ?DOMElement
{
    foreach ($names as $name) {
        $list = $xpath->query(
            './/*[local-name()="' . $name . '"]',
            $context
        );

        if ($list instanceof DOMNodeList && $list->length > 0) {
            $node = $list->item(0);

            if ($node instanceof DOMElement) {
                return $node;
            }
        }
    }

    return null;
}

function syncValue(DOMXPath $xpath, DOMNode $context, array $names): ?string
{
    return syncText(syncFirst($xpath, $context, $names));
}

function syncNumber(?string $value): ?float
{
    if ($value === null || trim($value) === '') {
        return null;
    }

    $value = str_replace(',', '.', trim($value));

    return is_numeric($value) ? (float)$value : null;
}

function syncHttpGet(string $url, int $timeout = 15): array
{
    $start = microtime(true);

    $context = stream_context_create([
        'http' => [
            'method' => 'GET',
            'timeout' => $timeout,
            'ignore_errors' => true,
            'protocol_version' => 1.1,
            'header' =>
                "Accept: application/xml, text/xml, */*\r\n" .
                "User-Agent: UTM-MONITOR/3.0\r\n" .
                "Connection: close\r\n"
        ]
    ]);

    $data = @file_get_contents($url, false, $context);

    $time = (int)round((microtime(true) - $start) * 1000);

    
    $status = 200;

    $responseHeaders = function_exists('http_get_last_response_headers')
        ? http_get_last_response_headers()
        : [];

    if (is_array($responseHeaders)) {
        foreach ($responseHeaders as $header) {
            if (preg_match('/HTTP\/\d+(?:\.\d+)?\s+(\d+)/i', $header, $m)) {
                $status = (int)$m[1];
            }
        }
    }
        }
    }

    if ($data === false) {
        return [
            'ok' => false,
            'status' => $status,
            'time' => $time,
            'data' => null,
            'error' => 'HTTP request failed'
        ];
    }

    return [
        'ok' => $status < 400,
        'status' => $status,
        'time' => $time,
        'data' => $data,
        'error' => $status >= 400 ? 'HTTP ' . $status : null
    ];
}

function syncGetUtm(PDO $db, int $utmId): ?array
{
    $stmt = $db->prepare(
        'SELECT * FROM utms WHERE id = :id LIMIT 1'
    );

    $stmt->execute([
        ':id' => $utmId
    ]);

    $utm = $stmt->fetch(PDO::FETCH_ASSOC);

    return $utm ?: null;
}

function syncDocumentTableColumns(PDO $db): array
{
    $columns = [];

    $stmt = $db->query('PRAGMA table_info(documents)');

    while ($row = $stmt->fetch(PDO::FETCH_ASSOC)) {
        $columns[] = $row['name'];
    }

    return $columns;
}

function syncSetDocumentField(
    array &$data,
    array $columns,
    string $column,
    mixed $value
): void {
    if (in_array($column, $columns, true)) {
        $data[$column] = $value;
    }
}

function syncDocumentUpsert(
    PDO $db,
    int $utmId,
    array $doc,
    string $rawXml
): string {
    $columns = syncDocumentTableColumns($db);

    $externalId = (string)(
        $doc['external_id']
        ?? ''
    );

    if ($externalId === '') {
        $externalId = 'queue:' .
            $doc['document_type'] . ':' .
            ($doc['queue_id'] ?? sha1($rawXml));
    }

    $technicalId = 'hash:' . sha1(
        implode('|', [
            (string)$doc['document_type'],
            (string)($doc['direction'] ?? ''),
            (string)($doc['number'] ?? ''),
            (string)($doc['document_date'] ?? ''),
            (string)($doc['sender'] ?? ''),
            (string)($doc['receiver'] ?? ''),
            $rawXml
        ])
    );

    $data = [];

    syncSetDocumentField($data, $columns, 'id', $technicalId);
    syncSetDocumentField($data, $columns, 'utm_id', $utmId);
    syncSetDocumentField($data, $columns, 'external_id', $externalId);
    syncSetDocumentField($data, $columns, 'direction', $doc['direction'] ?? 'outgoing');
    syncSetDocumentField($data, $columns, 'document_type', $doc['document_type'] ?? null);
    syncSetDocumentField($data, $columns, 'doc_type', $doc['document_type'] ?? null);
    syncSetDocumentField($data, $columns, 'number', $doc['number'] ?? null);
    syncSetDocumentField($data, $columns, 'document_date', $doc['document_date'] ?? null);
    syncSetDocumentField($data, $columns, 'sender', $doc['sender'] ?? null);
    syncSetDocumentField($data, $columns, 'receiver', $doc['receiver'] ?? null);
    syncSetDocumentField($data, $columns, 'status', $doc['status'] ?? null);
    syncSetDocumentField($data, $columns, 'raw_xml', $rawXml);
    syncSetDocumentField($data, $columns, 'created_at', date('Y-m-d H:i:s'));
    syncSetDocumentField($data, $columns, 'updated_at', date('Y-m-d H:i:s'));

    if (in_array('external_id', $columns, true)) {
        $stmt = $db->prepare(
            'SELECT id, status
             FROM documents
             WHERE external_id = :external_id
             LIMIT 1'
        );

        $stmt->execute([
            ':external_id' => $externalId
        ]);

        $existing = $stmt->fetch(PDO::FETCH_ASSOC);

        if ($existing) {
            $sets = [];
            $params = [
                ':id' => $existing['id']
            ];

            foreach ($data as $column => $value) {
                if ($column === 'id') {
                    continue;
                }

                $sets[] = '"' . $column . '" = :' . $column;
                $params[':' . $column] = $value;
            }

            if ($sets) {
                $sql =
                    'UPDATE documents SET ' .
                    implode(', ', $sets) .
                    ' WHERE id = :id';

                $update = $db->prepare($sql);
                $update->execute($params);
            }

            if (
                isset($existing['status']) &&
                isset($doc['status']) &&
                $existing['status'] !== $doc['status']
            ) {
                if (
                    in_array(
                        'document_status_history',
                        syncTables($db),
                        true
                    )
                ) {
                    $historyColumns = [];

                    $stmt = $db->query(
                        'PRAGMA table_info(document_status_history)'
                    );

                    while ($row = $stmt->fetch(PDO::FETCH_ASSOC)) {
                        $historyColumns[] = $row['name'];
                    }

                    $historyData = [];

                    syncSetDocumentField(
                        $historyData,
                        $historyColumns,
                        'document_id',
                        $existing['id']
                    );

                    syncSetDocumentField(
                        $historyData,
                        $historyColumns,
                        'old_status',
                        $existing['status']
                    );

                    syncSetDocumentField(
                        $historyData,
                        $historyColumns,
                        'new_status',
                        $doc['status']
                    );

                    syncSetDocumentField(
                        $historyData,
                        $historyColumns,
                        'created_at',
                        date('Y-m-d H:i:s')
                    );

                    syncInsertDynamic(
                        $db,
                        'document_status_history',
                        $historyData
                    );
                }
            }

            return (string)$existing['id'];
        }
    }

    syncInsertDynamic(
        $db,
        'documents',
        $data
    );

    return $technicalId;
}

function syncTables(PDO $db): array
{
    $tables = [];

    $stmt = $db->query(
        "SELECT name FROM sqlite_master
         WHERE type = 'table'"
    );

    while ($row = $stmt->fetch(PDO::FETCH_ASSOC)) {
        $tables[] = $row['name'];
    }

    return $tables;
}

function syncInsertDynamic(
    PDO $db,
    string $table,
    array $data
): void {
    if (!$data) {
        return;
    }

    $columns = array_keys($data);

    $quotedColumns = array_map(
        static fn(string $column): string => '"' . $column . '"',
        $columns
    );

    $placeholders = array_map(
        static fn(string $column): string => ':' . $column,
        $columns
    );

    $sql =
        'INSERT INTO "' . $table . '" (' .
        implode(', ', $quotedColumns) .
        ') VALUES (' .
        implode(', ', $placeholders) .
        ')';

    $stmt = $db->prepare($sql);

    $params = [];

    foreach ($data as $column => $value) {
        $params[':' . $column] = $value;
    }

    $stmt->execute($params);
}

